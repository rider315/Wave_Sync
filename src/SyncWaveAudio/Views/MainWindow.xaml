<Window x:Class="SyncWaveAudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SyncWaveAudio.Models"
        xmlns:views="clr-namespace:SyncWaveAudio.Views"
        Title="Synchord" Width="1180" Height="860" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/synchord_logo.png">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/synchord_logo.png" Width="42" Height="42" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Synchord" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" Margin="0,2,0,0" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <!-- Master Volume -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="🔊" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Width="100" Minimum="0" Maximum="1" Value="{Binding MasterVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource BrushMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⟳ Refresh" Command="{Binding RefreshDevicesCommand}" />
                    <Button Content="🎯 Calibrate" Command="{Binding CalibrateCommand}" />
                    <Button Content="⏹ Stop" Command="{Binding StopCommand}" />
                    <Button Content="▶ Start Sync" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="24,24,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Device List -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AudioDeviceInfo}">
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="18" Margin="0,0,18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.RowSpan="3" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSelectableOutput}" VerticalAlignment="Top" Margin="0,5,14,0" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Status dot -->
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource BrushAccent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Correcting">
                                                                <Setter Property="Fill" Value="{StaticResource BrushWarning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                <Setter Property="Fill" Value="{StaticResource BrushDanger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding DeviceRoleLabel}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding Codec, StringFormat=Codec: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding EstimatedLatencyMs, StringFormat=Latency: {0:F1} ms}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding DriftMs, StringFormat=Drift: {0:F1} ms}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushAccent}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="▲" Style="{StaticResource SmallButton}" Command="{Binding DataContext.MoveDeviceUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Move Up"/>
                                        <Button Content="▼" Style="{StaticResource SmallButton}" Command="{Binding DataContext.MoveDeviceDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Move Down"/>
                                        <Button Content="↻" Style="{StaticResource SmallButton}" Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Reconnect"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Delay" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" />
                                        <Slider Grid.Column="0" Margin="45,0,8,0" Minimum="0" Maximum="500" Value="{Binding ManualDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ManualDelayMs, StringFormat={}{0:F0} ms}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Volume" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" />
                                        <Slider Grid.Column="2" Margin="58,0,8,0" Minimum="0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat={}{0:P0}}" VerticalAlignment="Center" />
                                    </Grid>

                                    <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                        <CheckBox Content="Mono" IsChecked="{Binding Mono}" Margin="0,0,20,0" />
                                        <CheckBox Content="Enhance" IsChecked="{Binding EnhancementEnabled}" Margin="0,0,20,0" />
                                        <CheckBox Content="Spatial" IsChecked="{Binding SpatialPreferred}" Margin="0,0,20,0" />
                                        <TextBlock Text="{Binding BatteryPercent, TargetNullValue=Battery: n/a, StringFormat=🔋 {0}%}" Foreground="{StaticResource BrushMuted}" Margin="0,0,20,0" />
                                        <TextBlock Text="{Binding SignalStrength, TargetNullValue=Signal: n/a, StringFormat=📶 {0}%}" Foreground="{StaticResource BrushMuted}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Right Panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Live Audio Levels -->
                    <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🎧 Live Audio" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedDeviceCount, StringFormat=Selected devices: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,4" />
                            <TextBlock Text="{Binding SelectedRelayDeviceCount, StringFormat=Relay outputs: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,14" />
                            <TextBlock Text="Left" Foreground="{StaticResource BrushMuted}" />
                            <ProgressBar Height="12" Maximum="1" Value="{Binding PeakLeft}" Margin="0,6,0,12" Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushSurfaceAlt}" />
                            <TextBlock Text="Right" Foreground="{StaticResource BrushMuted}" />
                            <ProgressBar Height="12" Maximum="1" Value="{Binding PeakRight}" Margin="0,6,0,0" Foreground="{StaticResource BrushAccent2}" Background="{StaticResource BrushSurfaceAlt}" />
                        </StackPanel>
                    </Border>

                    <!-- Waveform Sync Visualizer (per-device) -->
                    <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="〰 Waveform Sync" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Per-device audio waveforms" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,4,0,6"/>
                            <!-- Master capture waveform -->
                            <Border Background="{StaticResource BrushBackground}" CornerRadius="6" Padding="4" Height="70" Margin="0,0,0,6">
                                <views:WaveformVisualizer Samples="{Binding WaveformSamples}" LabelText="Master Capture" />
                            </Border>
                            <!-- Per-device waveforms -->
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AudioDeviceInfo}">
                                        <Border Background="{StaticResource BrushBackground}" CornerRadius="6" Padding="4" Height="56" Margin="0,0,0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <views:WaveformVisualizer Samples="{Binding WaveformSamples}" LabelText="{Binding FriendlyName}" StrokeBrush="#63A4FF" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Sync Health -->
                    <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💚 Sync Health" FontSize="19" FontWeight="SemiBold" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="72" Height="72" CornerRadius="36" Margin="0,0,16,0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding SyncHealthColor, FallbackValue=#9AA7B8}" />
                                    </Border.Background>
                                    <TextBlock Text="{Binding SyncHealthPercent, StringFormat={}{0}%}" FontSize="22" FontWeight="Bold" Foreground="#0E1117" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="18" FontWeight="SemiBold">
                                        <TextBlock.Text><Binding Path="SyncHealthLabel" /></TextBlock.Text>
                                        <TextBlock.Foreground><SolidColorBrush Color="{Binding SyncHealthColor, FallbackValue=#9AA7B8}" /></TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MaxDriftMs, StringFormat=Max drift: {0:F1} ms}" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AvgDriftMs, StringFormat=Avg drift: {0:F1} ms}" Foreground="{StaticResource BrushMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Per-device drift bars -->
                            <TextBlock Text="Per-Device Drift" Foreground="{StaticResource BrushMuted}" Margin="0,16,0,6" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AudioDeviceInfo}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="65" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="50" Value="{Binding DriftMs, Mode=OneWay}" Background="{StaticResource BrushSurfaceAlt}" Margin="6,0">
                                                <ProgressBar.Foreground><SolidColorBrush Color="{StaticResource ColorAccent}" /></ProgressBar.Foreground>
                                            </ProgressBar>
                                            <TextBlock Grid.Column="2" Text="{Binding DriftMs, StringFormat={}{0:F1}ms}" FontSize="11" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{StaticResource BrushSurfaceAlt}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Capture Pipeline" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent2}" />
                                    <TextBlock Text="{Binding CaptureCallbackIntervalMs, StringFormat=Callback interval: {0:F1} ms}" FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding TotalCaptureCallbacks, StringFormat=Total callbacks: {0:N0}}" FontSize="11" Foreground="{StaticResource BrushMuted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Settings Panel -->
                    <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="⚙ Settings" FontSize="19" FontWeight="SemiBold" />

                            <!-- Quick Presets -->
                            <TextBlock Text="Quick Presets" Foreground="{StaticResource BrushMuted}" Margin="0,14,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⚡ Low Latency" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetLowLatencyCommand}" ToolTip="40ms buffer — minimal delay" />
                                <Button Content="⚖ Balanced" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetBalancedCommand}" ToolTip="80ms buffer — recommended" />
                                <Button Content="🛡 Stable" Style="{StaticResource PresetButton}" Command="{Binding ApplyPresetStableCommand}" ToolTip="160ms buffer — max reliability" />
                            </StackPanel>

                            <TextBlock Text="Buffer Size" Foreground="{StaticResource BrushMuted}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="35" Maximum="250" Value="{Binding BufferSizeMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TickFrequency="10" IsSnapToTickEnabled="True" />
                                <TextBlock Grid.Column="1" Text="{Binding BufferSizeMs, StringFormat={}{0} ms}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="◄ Low latency" FontSize="10" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Left" />
                                <TextBlock Text="Stable ►" FontSize="10" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="EQ preset" Foreground="{StaticResource BrushMuted}" Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding EqPresets}" SelectedItem="{Binding SelectedEqPreset}" />
                            <CheckBox Content="Party mode" IsChecked="{Binding PartyMode}" Margin="0,16,0,0" />
                            <CheckBox Content="Debug logging" IsChecked="{Binding DebugLogging}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Debug Log Panel -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}">
            <StackPanel>
                <Border Background="{StaticResource BrushSurfaceAlt}" Padding="24,8" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 Debug Log" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DebugLogs.Count, StringFormat= ({0} entries)}" FontSize="12" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CaptureLogsCommand}" Padding="10,4" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="📸 Capture 10s" />
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Content" Value="{Binding CaptureCountdown, StringFormat=⏺ Recording {0}s...}" />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearLogsCommand}" Padding="10,4" Margin="0,0,6,0" />
                        <Button Grid.Column="3" Command="{Binding ToggleDebugPanelCommand}" Padding="10,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="▼ Hide" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDebugPanelOpen}" Value="False">
                                            <Setter Property="Content" Value="▲ Show" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <Border MaxHeight="220" Padding="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDebugPanelOpen}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ListBox ItemsSource="{Binding DebugLogs}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             x:Name="DebugLogList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="24,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SyncLogEntry}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FormattedTime}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource BrushMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelTag}" FontSize="11" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                                        <Setter Property="Foreground" Value="#FFB84D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource BrushAccent2}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                                        <Setter Property="Foreground" Value="#FFB84D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BrushSurface}" Padding="24,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Default output = source anchor | Selected = relay outputs" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SessionUptime, StringFormat=⏱ {0}}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding BufferSizeMs, StringFormat=Buffer: {0}ms}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding SyncHealthLabel, StringFormat=Sync: {0}}" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock.Foreground><SolidColorBrush Color="{Binding SyncHealthColor, FallbackValue=#9AA7B8}" /></TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding IsRunning, StringFormat=Running: {0}}" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
