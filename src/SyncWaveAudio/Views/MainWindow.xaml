<Window x:Class="SyncWaveAudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SyncWaveAudio.Models"
        Title="SyncWave Audio" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" Padding="26,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SyncWave Audio" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshDevicesCommand}" />
                    <Button Content="Calibrate" Command="{Binding CalibrateCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                    <Button Content="Start Sync" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AudioDeviceInfo}">
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="18" Margin="0,0,18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.RowSpan="3"
                                              IsChecked="{Binding IsSelected}"
                                              IsEnabled="{Binding IsSelectableOutput}"
                                              VerticalAlignment="Top"
                                              Margin="0,5,14,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding FriendlyName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding DeviceRoleLabel}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding DeviceState, StringFormat=State: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding Codec, StringFormat=Codec: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding EstimatedLatencyMs, StringFormat=Latency: {0:F1} ms}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding DriftMs, StringFormat=Drift: {0:F1} ms}" Foreground="{StaticResource BrushMuted}" Margin="0,0,18,0" />
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource BrushAccent}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Up" Command="{Binding DataContext.MoveDeviceUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="Down" Command="{Binding DataContext.MoveDeviceDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="Reconnect" Command="{Binding DataContext.ReconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Delay" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" />
                                        <Slider Grid.Column="0" Margin="55,0,12,0" Minimum="0" Maximum="500" Value="{Binding ManualDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ManualDelayMs, StringFormat={}{0:F0} ms}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Volume" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" />
                                        <Slider Grid.Column="2" Margin="68,0,10,0" Minimum="0" Maximum="1.5" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Volume, StringFormat={}{0:P0}}" VerticalAlignment="Center" />
                                    </Grid>

                                    <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                        <CheckBox Content="Mono" IsChecked="{Binding Mono}" Margin="0,0,20,0" />
                                        <CheckBox Content="Enhance" IsChecked="{Binding EnhancementEnabled}" Margin="0,0,20,0" />
                                        <CheckBox Content="Spatial preferred" IsChecked="{Binding SpatialPreferred}" Margin="0,0,20,0" />
                                        <TextBlock Text="{Binding BatteryPercent, TargetNullValue=Battery: unavailable, StringFormat=Battery: {0}%}" Foreground="{StaticResource BrushMuted}" Margin="0,0,20,0" />
                                        <TextBlock Text="{Binding SignalStrength, TargetNullValue=Signal: unavailable, StringFormat=Signal: {0}%}" Foreground="{StaticResource BrushMuted}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Live Sync" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDeviceCount, StringFormat=Selected devices: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,4" />
                        <TextBlock Text="{Binding SelectedRelayDeviceCount, StringFormat=Relay outputs: {0}}" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,14" />
                        <TextBlock Text="Left" Foreground="{StaticResource BrushMuted}" />
                        <ProgressBar Height="12" Maximum="1" Value="{Binding PeakLeft}" Margin="0,6,0,12" Foreground="{StaticResource BrushAccent}" Background="{StaticResource BrushSurfaceAlt}" />
                        <TextBlock Text="Right" Foreground="{StaticResource BrushMuted}" />
                        <ProgressBar Height="12" Maximum="1" Value="{Binding PeakRight}" Margin="0,6,0,0" Foreground="{StaticResource BrushAccent2}" Background="{StaticResource BrushSurfaceAlt}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Sync Calibration" FontSize="19" FontWeight="SemiBold" />
                        <Canvas Height="110" Margin="0,18,0,10" Background="{StaticResource BrushSurfaceAlt}">
                            <Polyline Points="0,70 24,70 32,24 42,86 55,70 90,70 102,34 118,78 132,70 360,70"
                                      Stroke="{StaticResource BrushAccent}" StrokeThickness="3" />
                            <Polyline Points="0,62 28,62 38,32 48,82 62,62 96,62 110,38 126,76 142,62 360,62"
                                      Stroke="{StaticResource BrushAccent2}" StrokeThickness="2" Opacity="0.82" />
                        </Canvas>
                        <TextBlock Text="Calibration uses timestamp-aligned tone playback and updates delay offsets for selected devices."
                                   TextWrapping="Wrap" Foreground="{StaticResource BrushMuted}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="EQ preset" Foreground="{StaticResource BrushMuted}" Margin="0,14,0,6" />
                        <ComboBox ItemsSource="{Binding EqPresets}" SelectedItem="{Binding SelectedEqPreset}" />
                        <CheckBox Content="Party mode" IsChecked="{Binding PartyMode}" Margin="0,16,0,0" />
                        <CheckBox Content="Detailed debug logging" IsChecked="{Binding DebugLogging}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" Padding="24,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Default output is source anchor | Selected devices are relay outputs | Adaptive buffering" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding IsRunning, StringFormat=Running: {0}}" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
